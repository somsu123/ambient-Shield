# ── Ambient Shield Environment Variables ───────────────────────────────────
# Ambient Shield supports both local inference (Ollama) and high-speed Groq Cloud API.

# Local Ollama endpoint and model (default: Gemma 3 4B)
NEXT_PUBLIC_OLLAMA_HOST=http://localhost:11434
NEXT_PUBLIC_OLLAMA_MODEL=gemma3:4b

# Groq Cloud API (Ultra-fast fact & job verification)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
NEXT_PUBLIC_GROQ_API_KEY=gsk_your_groq_api_key_here
NEXT_PUBLIC_GROQ_MODEL=qwen/qwen3.8-27b

# Default LLM Provider: "groq" or "ollama"
DEFAULT_LLM_PROVIDER=groq
NEXT_PUBLIC_DEFAULT_LLM_PROVIDER=groq

# App base URL (used for absolute links, OG tags, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
