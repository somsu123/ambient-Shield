# ── Ambient Shield Environment Variables ───────────────────────────────────
# Ambient Shield uses a 100% local LLM provider (Ollama + Gemma).
# ZERO cloud API keys required. Zero data leaves your machine for AI reasoning.

# Local Ollama endpoint and model (default: Gemma 3 4B)
NEXT_PUBLIC_OLLAMA_HOST=http://localhost:11434
NEXT_PUBLIC_OLLAMA_MODEL=gemma3:4b

# App base URL (used for absolute links, OG tags, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
